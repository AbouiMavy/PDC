# Exemple uniquement : copier localement en .env (jamais dans Git).
# L'API est LOCALE uniquement ; aucune mise en production prévue.
PDC_API_HOST=127.0.0.1
PDC_API_PORT=8787
PDC_API_ENABLE_DB=false
SUPABASE_URL=https://YOUR-DEV-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_DEV_PUBLISHABLE_KEY
# Uniquement après création d'un LOGIN technique restreint (jamais postgres/service_role) :
# DATABASE_URL=postgresql://YOUR_RESTRICTED_ROLE:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
# PDC_PG_CA_FILE=/path/to/verified/ca.pem
# ALLOWED_ORIGINS=http://127.0.0.1:5173
